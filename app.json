{
  "expo": {
    "name": "lifttrack",
    "slug": "lifttrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-limpio.png",
    "scheme": "lifttrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#03090B",
        "foregroundImage": "./assets/logo-limpio.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.juancagenuine.lifttrack"
    },
    "web": {
      "favicon": "./assets/logo-limpio.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03090B",
          "image": "./assets/logo-titulo-no-bg.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
